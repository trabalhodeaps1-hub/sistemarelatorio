APP_NAME="AutoRelatório Industrial"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://os.suaempresa.com.br
APP_DOMAIN=os.suaempresa.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autorelatorio
